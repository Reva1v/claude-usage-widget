<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClaudeUsageWidget.Core\ClaudeUsageWidget.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeUsageWidget.App.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon and ContextMenuStrip live in WinForms; WPF has no tray of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's icon (Start menu/Explorer/taskbar). It does not set the tray
         icon — that one is drawn dynamically with a live number (TrayIconRenderer). -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>0.2.7</Version>
    <AssemblyTitle>Claude Usage Widget</AssemblyTitle>
    <!-- WFO0003 (WFAC010 before the .NET 9 SDK) suggests ApplicationHighDpiMode/SetHighDpiMode — APIs from the
         WinForms-application world. Here the host process is WPF, WinForms is used
         only for the tray, and PerMonitorV2 in the manifest is the documented way to
         get DPI-awareness for WPF, so the warning does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Precompiled (crossgen) code in the publish output: less JIT work and memory at run time. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

</Project>
