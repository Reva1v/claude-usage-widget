<UserControl x:Class="ClaudeUsageWidget.App.Views.WidgetRootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ClaudeUsageWidget.App.Views"
             Background="Transparent"
             ClipToBounds="True">
    <UserControl.Resources>
        <!-- A flat icon button: without the standard WPF chrome (border/highlight),
             which wouldn't fit into the dark panel. Port of .buttonStyle(.plain). -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SignInButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{x:Static views:Theme.TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{x:Static views:Theme.DimBrush}"
                                Opacity="0.35"
                                CornerRadius="10"
                                Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Background="Transparent", not absent: a Panel without a Background does
         not hit-test on its own empty pixels, and edit mode has to see a press
         anywhere on the square — including the padding, where a press must NOT
         reach the window's drag. -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- The panel: a dark translucent background with rounded corners, with a
             grid of dials ONE ROW PER ACCOUNT inside. The order of children in
             the Grid is also the drawing order (z-order), like the overlay
             chain in WidgetRootView.swift.

             The grid is empty in markup and is built in ApplyLayout: the number
             of rows equals the number of configured accounts and changes at
             runtime (adding/removing an account), and the four named dials
             that used to be in XAML were exactly the hardcoded 2x2 layout that
             this replaces. Service status is no longer a dial: it's shared
             across all accounts and moved to the status line. -->
        <Border x:Name="PanelBorder" Background="{x:Static views:Theme.PanelBackgroundBrush}">
            <Grid x:Name="DialGrid" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- A notice card over the dials when their numbers can't be trusted
             (NoCredentials/Unauthorized). Port of BlockingNotice.swift +
             overlay in WidgetRootView.swift:186-208.

             IsHitTestVisible here is deliberately NOT turned off (unlike the
             Swift original, where .allowsHitTesting(false) keeps the whole
             notice transparent to clicks): in WPF turning off hit-testing on
             an ancestor disables it for the entire subtree, including
             SignInButton, and there's no way to make the button clickable
             again from below. Instead we simply don't block bubbling: the
             Border itself and the text blocks don't set e.Handled, so a click
             on the notice's background still reaches DesktopWidgetWindow and
             starts a drag — the same effect, without losing the button. -->
        <Border x:Name="NoticeBorder" Background="{x:Static views:Theme.OverlayBackgroundBrush}"
                Visibility="Collapsed">
            <StackPanel x:Name="NoticeStack" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="NoticeTitleText" HorizontalAlignment="Center" TextAlignment="Center"
                           FontFamily="{x:Static views:Theme.FontFamily}" FontWeight="{x:Static views:Theme.ValueWeight}"
                           Foreground="{x:Static views:Theme.TextBrush}"/>
                <TextBlock x:Name="NoticeDetailText" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontFamily="{x:Static views:Theme.FontFamily}" FontWeight="{x:Static views:Theme.CaptionWeight}"
                           Foreground="{x:Static views:Theme.DimBrush}"/>
                <!-- Visible only for Failed(NoCredentials) — SetContent toggles Visibility. -->
                <Button x:Name="SignInButton" Content="Sign in" Margin="0,8,0,0"
                        Style="{StaticResource SignInButtonStyle}"
                        Visibility="Collapsed"
                        Click="SignInButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Hover header: eye (hide), pencil (edit layout) and lock (position).
             Visible only while the pointer is over the panel and the edit mode
             is off — in the mode the strip below carries the same buttons and
             the top row of cells must stay draggable. WidgetRootView.swift:110-166. -->
        <Border x:Name="HeaderBorder" VerticalAlignment="Top" Background="{x:Static views:Theme.OverlayBackgroundBrush}"
                Opacity="0" IsHitTestVisible="False">
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="EyeButton" Grid.Column="0" Style="{StaticResource IconButtonStyle}"
                        Foreground="{x:Static views:Theme.DimBrush}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE890;"
                        ToolTip="Hide widget — bring it back from the tray icon"
                        Click="EyeButton_Click"/>

                <Button x:Name="PencilButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                        Foreground="{x:Static views:Theme.DimBrush}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE70F;"
                        ToolTip="Edit layout — drag a cell onto another to swap them"
                        Click="PencilButton_Click"/>

                <Button x:Name="LockButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                        Foreground="{x:Static views:Theme.DimBrush}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE785;"
                        ToolTip="Click to lock the widget position and size"
                        Click="LockButton_Click"/>
            </Grid>
        </Border>

        <!-- Edit toolbar: one strip, only while EditMode is on, in a band
             OUTSIDE the rounded panel — above it when the screen has room,
             below it otherwise. The window grows by the band and moves its own
             top to match, so the panel keeps the size and the position it has
             with the mode off; overlaying it is what the deleted hover header
             got wrong, and reserving space INSIDE it is what the user saw as
             the panel resizing and then sitting elsewhere.

             The buttons ride on a rounded pill of the panel's own background,
             because outside the panel there is nothing behind them: dim glyphs
             on bare wallpaper are a strip you cannot find. The pill is sized to
             the button row and padded out of the band's existing gap, so it
             costs no geometry.

             Alignment, padding and corners come from LayoutToolbar (the side is
             not known here), and the row/column counts from Core's
             ToolbarMetrics, so what is drawn and what the window grew by cannot
             disagree. -->
        <Border x:Name="ToolbarPill" Background="{x:Static views:Theme.PanelBackgroundBrush}"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Visibility="Collapsed">
            <Grid x:Name="EditToolbar"/>
        </Border>

        <!-- The status line — stays silent while everything is fine (StatusLine.Text
             returns null). WidgetRootView.swift:170-177. -->
        <TextBlock x:Name="StatusLineText" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   FontFamily="{x:Static views:Theme.FontFamily}" FontWeight="{x:Static views:Theme.CaptionWeight}"
                   Foreground="{x:Static views:Theme.DimBrush}"
                   Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- Edit-mode chrome: dashed cell outlines, the drag ghost, the target
             highlight. A layer of its own so the normal layout never moves,
             and a Canvas rather than the AdornerLayer because
             RenderTargetBitmap does not draw adorners — the offscreen preview
             would render every edit-mode PNG with the chrome missing. -->
        <Canvas x:Name="EditLayer" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
